{
    "name": "@page-agent/cli",
    "private": false,
    "version": "1.8.1",
    "type": "module",
    "description": "CLI harness for page-agent — control any browser tab via CDP without MCP",
    "keywords": [
        "page-agent",
        "cli",
        "browser-automation",
        "cdp",
        "web-agent",
        "ai-agent"
    ],
    "author": "Simon<gaomeng1900>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/alibaba/page-agent.git",
        "directory": "packages/cli"
    },
    "homepage": "https://alibaba.github.io/page-agent/",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "page-agent-cli": "dist/cli.js"
    },
    "files": [
        "dist/",
        "AGENT_GUIDE.md",
        "SKILL.md"
    ],
    "scripts": {
        "prebuild": "npm run build:iife:all -w @page-agent/page-controller",
        "predev": "npm run build:iife:all -w @page-agent/page-controller",
        "build": "vite build",
        "dev": "vite build --watch",
        "prepublishOnly": "node ../../scripts/pre-publish.js",
        "postpublish": "node ../../scripts/post-publish.js"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "commander": "^14.0.3",
        "ws": "^8.20.0",
        "zod": "^4.4.1"
    },
    "devDependencies": {
        "@page-agent/core": "1.8.1",
        "@page-agent/llms": "1.8.1",
        "@page-agent/page-controller": "1.8.1",
        "@types/ws": "^8.18.1"
    }
}
